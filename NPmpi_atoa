			# multiply by 2 because we sent size * iterations * 2
			rate = ((size_r*iters_r*2)/(totalTime))
			output = "%12d %15.2lf %12.8lf %8d" % (int(size_r/8),rate/(1e6),onewayTime,iters_r)
