sock = None
ADDR = None
MYPORT = 29543

def checkforRT(host=None):
	fname = "/tmp/NPRTHOST"
	global sock, ADDR
	if ADDR:
		return
	
	if not sock:	
		sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

	if not host:
		try:
			f = open(fname)
		except IOError:
			return None
		host = f.read().strip()
		print "Found new %s, sending to host %s" % (fname, host)
	ADDR = (host, MYPORT)
	return

def sendRT(data):
	global sock, ADDR
	if ADDR:
		sock.sendto("(%s,%s)" % (repr(time.time()), data), ADDR)

